# Data (raw/interim/processed are fetched or generated, not source-controlled)
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Trained models (large binaries, regenerated from code + data)
models/*
!models/.gitkeep

# Generated figures (regenerated from code + data)
reports/figures/*
!reports/figures/.gitkeep

# Logs
logs/*
!logs/.gitkeep

# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Virtual environments
.venv/
venv/

# Jupyter
.ipynb_checkpoints/

# OS / editor
.DS_Store
Thumbs.db
